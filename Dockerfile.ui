FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir uv==0.8.15

# Install the locked runtime dependencies plus the optional Streamlit extra
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --locked --no-dev --extra app --no-install-project

# The UI only needs its own package, the reference CSV and the Streamlit theme: no model, no API code
COPY src/research_app ./src/research_app
COPY data/abalone.csv ./data/abalone.csv
COPY .streamlit ./.streamlit
COPY streamlit_app.py ./

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app/src" \
    API_BASE_URL="http://api:8001"

EXPOSE 8501

CMD ["streamlit", "run", "streamlit_app.py", "--server.address", "0.0.0.0", "--server.port", "8501", "--server.headless", "true"]
